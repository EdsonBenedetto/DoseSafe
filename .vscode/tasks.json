{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DoseSafe: sincronizar lista de ICs",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/sync_ics.py",
        "--watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "doseSafe-ics-sync",
        "pattern": [
          {
            "regexp": "^$",
            "message": 0
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Acompanhando mudanças no DoseSafe",
          "endsPattern": "Sincronização automática encerrada"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
